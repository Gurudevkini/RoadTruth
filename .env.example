# RoadTruth Environment Configuration Example
# Copy this file to .env and configure for your environment.

# Flask Application Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Secret Key (Replace with a random secure string in production)
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars

# Database URL (Defaults to SQLite at backend/instance/roadtruth.sqlite3)
DATABASE_URL=sqlite:///backend/instance/roadtruth.sqlite3

# Allowed CORS Origins (Comma-separated origins for React frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Routing Engine Configuration
# Configurable routing provider (defaults to public OpenStreetMap OSRM router: https://router.project-osrm.org)
# Self-hosted OSRM or enterprise traffic routing API can be specified here.
ROUTING_PROVIDER_URL=https://router.project-osrm.org

